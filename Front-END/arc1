/* Courses Buttons */

.coursebuttons img {
    transition: border-radius 0.15s ease, scale 0.2s ease;
    transition: border-radius 0.15s ease-out, scale 0.2s ease-out;
}

#C1 {
    position: absolute;
    scale: 12%;
    width: 50rem;
    border-radius: 7rem;
    transform: translateX(-350rem) translateY(-210rem);
}

#C1 h2 {
    position: relative;
    font-size: 7rem;
    font-weight: 600;
    text-align: center;
    transform: translateY(-1.5rem);
}

#C1:hover>h2 {
    color: #E5F2E0;
}

#C1 img {
    position: relative;
    max-width: 35rem;
    max-height: 35rem;
    border-radius: 7rem;
    margin-top: 5rem;
    margin-bottom: 5rem;
    transform: translateX(-1.5rem);

}

#C1:hover>img {
    border-radius: 50%;
    scale: 115%;

}

